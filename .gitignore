!data/raw/sensors_registry.json

# Serving artifacts the API/Dockerfile need to actually run (small).
# Big comparison models (Random Forest 79MB+239MB, train/test data) stay ignored —
# their scores are preserved in the metrics JSON below, and the 239MB RF exceeds
# GitHub's 100MB per-file limit anyway.
!step_4_regression/artifacts/best_model.joblib
!step_5_classification/artifacts/xgboost_hybrid_calibrated.joblib
!step_3_eda/daily_dataset_clean.parquet
# Metrics JSON used by summary.ipynb and the README results tables (all tiny)
!step_4_regression/artifacts/*.json
!step_5_classification/artifacts/*.json
!step_6_clustering/artifacts/*.json

